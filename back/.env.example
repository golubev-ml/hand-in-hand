# Настройки бэкенда для локального запуска. Скопируй в back/.env (файл в .gitignore).
# Реальные пароли и ключи в репозиторий не коммитим!
DATABASE_URL=sqlite:///./local.db
SECRET_KEY=СЮДА_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА
ADMIN_LOGIN=hand_admin
ADMIN_PASSWORD=СЮДА_ЛОКАЛЬНЫЙ_ПАРОЛЬ

# HIH-9: оплата Сбербанком. Учётные данные заводятся в /admin/settings (хранятся в БД),
# переменные ниже — фолбэк. Без них при включённой оплате /api/orders ответит 503.
APP_ENV=local
BASE_URL=http://localhost:8000
SBER_BASE_URL=https://ecomtest.sberbank.ru/ecomm/gateway/api/rest/
SBER_USER_NAME=
SBER_PASSWORD=
SBER_KEY=
SBER_VERIFY_SSL=true
SBER_PAYMENTS_ENABLED=
