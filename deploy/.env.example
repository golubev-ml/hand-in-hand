# Скопируй в deploy/.env и заполни реальными значениями. Сам .env в git не коммитится!
APP_ENV=local   # local | test | prod

# ─── Домены (HIH-9) ───────────────────────────────────────────────────────────
# traefik режет сертификаты по HTTP-01, наружу торчат только 80/443
DOMAIN=hand-in-hand.ru              # основной сайт (FastAPI + фронтенд + /admin)
LANDING_DOMAIN=hand.hand-in-hand.ru # лендинг-одностраничник (чистая статика, nginx)
LEGACY_DOMAIN=hand-in-hand-kzn.ru   # старый домен работает на основной сайт (переходный период)
LANDING_DIR=/root/landing           # папка на сервере, монтируется в nginx ro
ACME_EMAIL=m2a2x2000@gmail.com
BASE_URL=https://hand-in-hand.ru    # из него строятся returnUrl/failUrl для шлюза

# ─── База ─────────────────────────────────────────────────────────────────────
POSTGRES_DB=hand_in_hand
POSTGRES_USER=postgres
POSTGRES_PASSWORD=СЮДА_СЛОЖНЫЙ_ПАРОЛЬ
DATABASE_URL=postgresql://postgres:СЮДА_СЛОЖНЫЙ_ПАРОЛЬ@db:5432/hand_in_hand

# ─── Секреты приложения ───────────────────────────────────────────────────────
SECRET_KEY=СЮДА_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА
ADMIN_LOGIN=admin
ADMIN_PASSWORD=СЮДА_СЛОЖНЫЙ_ПАРОЛЬ_АДМИНА

# ─── Почта ────────────────────────────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
EMAIL_ENABLED=true
MAIL_FROM=noreply@kraski-detstva.ru

# ─── Оплата: Сбербанк ecomm (HIH-9) ──────────────────────────────────────────
# Основные учётные данные шлюза хранятся в БД и вводятся в /admin/settings;
# переменные ниже — только фолбэк (например, для test-контура).
SBER_BASE_URL=https://ecomtest.sberbank.ru/ecomm/gateway/api/rest/
# Бой (когда придёт время): https://securepay.sberbank.ru/ecomm/gateway/api/rest/
SBER_USER_NAME=
SBER_PASSWORD=
SBER_KEY=
SBER_TERMINAL=
SBER_KEY_ID=
# Флаг «оплата включена» тоже хранится в БД; env-значения: true|false
SBER_PAYMENTS_ENABLED=
