FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY front/package.json front/package-lock.json ./
RUN npm ci
COPY front/ ./
# Текст «Условий использования» общий для лендинга и галереи — берём из legal/,
# чтобы редакция не разъезжалась на два файла.
COPY legal/ ./legal/
ARG VITE_YANDEX_METRIKA_ID=""
ARG VITE_SITE_HOST=""
ARG VITE_LANDING_URL=""
ENV VITE_YANDEX_METRIKA_ID=${VITE_YANDEX_METRIKA_ID}
ENV VITE_SITE_HOST=${VITE_SITE_HOST}
ENV VITE_LANDING_URL=${VITE_LANDING_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
