FROM nginx:1.27-alpine

ENV NGINX_ENVSUBST_OUTPUT_DIR=/usr/share/nginx/html

COPY deploy/nginx-landing.conf /etc/nginx/conf.d/default.conf
# Весь лендинг (css/js/images) едет в образ — страница статическая, без сборщика.
COPY landing/ /usr/share/nginx/html/
# Переиспользуем оптимизированный логотип основного сайта, не дублируя исходник 4,7 МБ.
COPY back/static/logo.png /usr/share/nginx/html/images/logo.png
# index.html дополнительно лежит шаблоном: nginx при старте подставляет
# ${SITE_URL}/${SITE_HOST} и ${YANDEX_METRIKA_ID} и пишет результат в веб-рут,
# перетирая копию выше. Поэтому внутри index.html не должно быть других `$`-паттернов.
COPY landing/index.html /etc/nginx/templates/index.html.template

# Страница «Условия использования»: единый текст (legal/terms.ru.html) + оболочка
# лендинга. Файл собирается на этапе build, поэтому правки текста не требуют
# трогать ни nginx, ни React.
COPY legal/terms.ru.html /tmp/legal/terms.body.html
COPY landing/terms.head.html /tmp/legal/terms.head.html
COPY landing/terms.foot.html /tmp/legal/terms.foot.html
RUN cat /tmp/legal/terms.head.html /tmp/legal/terms.body.html /tmp/legal/terms.foot.html \
      > /usr/share/nginx/html/terms.html \
 && rm -rf /tmp/legal \
 && rm -f /usr/share/nginx/html/terms.head.html /usr/share/nginx/html/terms.foot.html
