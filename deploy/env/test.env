# Test server. Keep its current YANDEX_METRIKA_ID in deploy/.env on the server.
APP_ENV=test
DOMAIN=hand-in-hand-kzn.ru
LANDING_DOMAIN=hand.hand-in-hand-kzn.ru
SITE_URL=https://hand-in-hand-kzn.ru
SITE_HOST=hand-in-hand-kzn.ru
BASE_URL=https://hand-in-hand-kzn.ru
SBER_BASE_URL=https://ecomtest.sberbank.ru/ecomm/gateway/api/rest/
# The Sber test contour currently serves a self-signed certificate chain.
SBER_VERIFY_SSL=false
YANDEX_METRIKA_ID=112291835
USE_EXTERNAL_TRAEFIK=false
TRAEFIK_NETWORK=deploy_web
